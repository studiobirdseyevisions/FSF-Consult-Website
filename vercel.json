{
  "rewrites": [
    { "source": "/poster", "destination": "/api/poster/admin" }
  ],
  "headers": [
    {
      "source": "/poster",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/poster/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "functions": {
    "api/poster/*.mjs": { "maxDuration": 60 }
  }
}
